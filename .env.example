# Copy this file to .env and replace the placeholder values locally.
# Spring Boot automatically imports .env when started from the project root.

NYC_REVIEW_DB_URL=jdbc:mysql://127.0.0.1:3306/nyc_review?useSSL=false&serverTimezone=UTC
NYC_REVIEW_DB_USERNAME=root
NYC_REVIEW_DB_PASSWORD=replace-with-your-local-password

NYC_REVIEW_REDIS_HOST=localhost
NYC_REVIEW_REDIS_PORT=6379
NYC_REVIEW_REDIS_DATABASE=0
NYC_REVIEW_REDIS_USERNAME=
NYC_REVIEW_REDIS_PASSWORD=

NYC_REVIEW_RABBITMQ_HOST=localhost
NYC_REVIEW_RABBITMQ_PORT=5672
NYC_REVIEW_RABBITMQ_USERNAME=guest
NYC_REVIEW_RABBITMQ_PASSWORD=guest
NYC_REVIEW_RABBITMQ_CONFIRM_TIMEOUT=5s

DEEPSEEK_API_KEY=replace-with-your-api-key
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

NYC_REVIEW_IMAGE_UPLOAD_DIR=/absolute/path/to/nginx/html/nyc-review/imgs

# Optional. Increases NYC Open Data API quota when refreshing the P6 source snapshot.
NYC_OPEN_DATA_APP_TOKEN=

# Optional protection for GET /v1/agent/metrics.
NYC_REVIEW_AGENT_METRICS_TOKEN=replace-with-a-local-observability-token

# Optional bearer key protecting the read-only Streamable HTTP MCP endpoint at /mcp.
NYC_REVIEW_AGENT_MCP_API_KEY=replace-with-a-local-mcp-token
