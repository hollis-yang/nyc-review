# Copy this file to .env and replace the placeholder values locally.
# Spring Boot automatically imports .env when started from the project root.

HMDP_DB_URL=jdbc:mysql://127.0.0.1:3306/hmdp_new?useSSL=false&serverTimezone=UTC
HMDP_DB_USERNAME=root
HMDP_DB_PASSWORD=replace-with-your-local-password

HMDP_REDIS_HOST=localhost
HMDP_REDIS_PORT=6379
HMDP_REDIS_DATABASE=0
HMDP_REDIS_USERNAME=
HMDP_REDIS_PASSWORD=

HMDP_RABBITMQ_HOST=localhost
HMDP_RABBITMQ_PORT=5672
HMDP_RABBITMQ_USERNAME=guest
HMDP_RABBITMQ_PASSWORD=guest
HMDP_RABBITMQ_CONFIRM_TIMEOUT=5s

DEEPSEEK_API_KEY=replace-with-your-api-key
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

HMDP_IMAGE_UPLOAD_DIR=/absolute/path/to/nginx/html/hmdp/imgs

# Optional protection for GET /v1/agent/metrics.
HMDP_AGENT_METRICS_TOKEN=replace-with-a-local-observability-token
