HMDP_AGENT_ADAPTER=http
HMDP_AGENT_BACKEND_BASE_URL=http://127.0.0.1:8081
# Required for the HTTP adapter; use the current local login token and never commit it.
HMDP_AGENT_BACKEND_AUTH_TOKEN=

HMDP_AGENT_RAG_ADAPTER=qdrant
HMDP_AGENT_QDRANT_LOCATION=http://127.0.0.1:6333
HMDP_AGENT_QDRANT_COLLECTION=hmdp_content_v2
HMDP_AGENT_RETRIEVAL_VERSION=p12-rag-v1
# P8 startup rejects datasets that are not REAL_ONLY or contain any mock shop identity.
HMDP_AGENT_RAG_DATA_DIRECTORY=../data/generated/nyc-real-medium
# Incremental synchronization streams this many documents per hash-check/upsert batch.
HMDP_AGENT_RAG_INDEX_BATCH_SIZE=128
# Spring/Generated adapter returns a broad pool; P12 RAG selects the final cards.
HMDP_AGENT_DISCOVERY_POOL_SIZE=50
HMDP_AGENT_MAX_CANDIDATES=5

# Deterministic local embeddings are only for development and tests.
HMDP_AGENT_EMBEDDING_PROVIDER=hash
HMDP_AGENT_EMBEDDING_DIMENSIONS=64

# Production example:
# HMDP_AGENT_EMBEDDING_PROVIDER=openai
# HMDP_AGENT_EMBEDDING_BASE_URL=https://api.openai.com/v1
# HMDP_AGENT_EMBEDDING_API_KEY=
# HMDP_AGENT_EMBEDDING_MODEL=text-embedding-3-small
# HMDP_AGENT_EMBEDDING_DIMENSIONS=1536
