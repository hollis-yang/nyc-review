HMDP_AGENT_ADAPTER=mock
HMDP_AGENT_BACKEND_BASE_URL=http://127.0.0.1:8081
HMDP_AGENT_BACKEND_AUTH_TOKEN=

HMDP_AGENT_RAG_ADAPTER=qdrant
HMDP_AGENT_QDRANT_LOCATION=./.local/qdrant
HMDP_AGENT_QDRANT_COLLECTION=hmdp_content_v1
HMDP_AGENT_RAG_DATA_DIRECTORY=../data/generated/nyc-small

# Deterministic local embeddings are only for development and tests.
HMDP_AGENT_EMBEDDING_PROVIDER=hash
HMDP_AGENT_EMBEDDING_DIMENSIONS=64

# Production example:
# HMDP_AGENT_EMBEDDING_PROVIDER=openai
# HMDP_AGENT_EMBEDDING_BASE_URL=https://api.openai.com/v1
# HMDP_AGENT_EMBEDDING_API_KEY=
# HMDP_AGENT_EMBEDDING_MODEL=text-embedding-3-small
# HMDP_AGENT_EMBEDDING_DIMENSIONS=1536
