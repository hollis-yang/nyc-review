NYC_REVIEW_AGENT_ADAPTER=http
NYC_REVIEW_AGENT_BACKEND_BASE_URL=http://127.0.0.1:8081
# Required for the HTTP adapter; use the current local login token and never commit it.
NYC_REVIEW_AGENT_BACKEND_AUTH_TOKEN=

NYC_REVIEW_AGENT_RAG_ADAPTER=qdrant
NYC_REVIEW_AGENT_QDRANT_LOCATION=http://127.0.0.1:6333
NYC_REVIEW_AGENT_QDRANT_API_KEY=
NYC_REVIEW_AGENT_QDRANT_COLLECTION=nyc_review_content_v2
NYC_REVIEW_AGENT_RETRIEVAL_VERSION=p12-rag-v1
# P8 startup rejects datasets that are not REAL_ONLY or contain any mock shop identity.
NYC_REVIEW_AGENT_RAG_DATA_DIRECTORY=../data/generated/nyc-real-medium
# Incremental synchronization streams this many documents per hash-check/upsert batch.
NYC_REVIEW_AGENT_RAG_INDEX_BATCH_SIZE=128
# Spring/Generated adapter returns a broad pool; P12 RAG selects the final cards.
NYC_REVIEW_AGENT_DISCOVERY_POOL_SIZE=50
NYC_REVIEW_AGENT_MAX_CANDIDATES=5

# M2 global retrieval is opt-in. Keep false for normal runtime and enable only
# for an explicitly versioned local Eval collection until all rollout gates pass.
NYC_REVIEW_AGENT_GLOBAL_RETRIEVAL_ENABLED=false
NYC_REVIEW_AGENT_GLOBAL_RETRIEVAL_DOCUMENT_LIMIT=200
NYC_REVIEW_AGENT_GLOBAL_RETRIEVAL_HYDRATION_LIMIT=60
NYC_REVIEW_AGENT_GLOBAL_RETRIEVAL_FUSION_POOL_LIMIT=30
NYC_REVIEW_AGENT_GLOBAL_RETRIEVAL_HYDRATION_CONCURRENCY=8
NYC_REVIEW_AGENT_GLOBAL_RETRIEVAL_BRANCH_TIMEOUT_SECONDS=15
NYC_REVIEW_AGENT_GLOBAL_RETRIEVAL_DOCUMENTS_PER_MERCHANT=3
NYC_REVIEW_AGENT_GLOBAL_RETRIEVAL_RRF_K=60
NYC_REVIEW_AGENT_GLOBAL_RETRIEVAL_BRAND_CAP=2

# M4 is opt-in and runs only after M3 has produced a bounded Fusion pool.
# qwen3-rerank can reuse DASHSCOPE_API_KEY; configure a separate
# /compatible-api/v1 URL only when it cannot be derived from DASHSCOPE_BASE_URL.
NYC_REVIEW_AGENT_RERANKER_PROVIDER=disabled
NYC_REVIEW_AGENT_RERANKER_MODEL=qwen3-rerank
NYC_REVIEW_AGENT_RERANKER_VERSION=
NYC_REVIEW_AGENT_RERANKER_BASE_URL=
NYC_REVIEW_AGENT_RERANKER_API_KEY=
NYC_REVIEW_AGENT_RERANKER_CANDIDATE_LIMIT=30
NYC_REVIEW_AGENT_RERANKER_TIMEOUT_SECONDS=8
NYC_REVIEW_AGENT_RERANKER_MAX_CONCURRENCY=2
NYC_REVIEW_AGENT_RERANKER_MAX_RETRIES=0
NYC_REVIEW_AGENT_RERANKER_CACHE_SIZE=512
NYC_REVIEW_AGENT_RERANKER_CACHE_TTL_SECONDS=900
NYC_REVIEW_AGENT_RERANKER_CIRCUIT_FAILURE_THRESHOLD=3
NYC_REVIEW_AGENT_RERANKER_CIRCUIT_COOLDOWN_SECONDS=30

# Deterministic local embeddings are only for development and tests. Production
# and staging reject Hash unless the override is set explicitly.
NYC_REVIEW_AGENT_EMBEDDING_PROVIDER=hash
NYC_REVIEW_AGENT_EMBEDDING_DIMENSIONS=64
NYC_REVIEW_AGENT_ALLOW_HASH_EMBEDDINGS=false

# Shared M1 provider controls. The frozen Eval profiles additionally lock model,
# dimension, price, and per-build cost ceiling.
NYC_REVIEW_AGENT_EMBEDDING_VERSION=
NYC_REVIEW_AGENT_EMBEDDING_BATCH_SIZE=64
NYC_REVIEW_AGENT_EMBEDDING_MAX_CONCURRENCY=2
NYC_REVIEW_AGENT_EMBEDDING_TIMEOUT_SECONDS=30
NYC_REVIEW_AGENT_EMBEDDING_MAX_RETRIES=4
NYC_REVIEW_AGENT_EMBEDDING_MAX_BATCH_CHARACTERS=250000
NYC_REVIEW_AGENT_EMBEDDING_QUERY_CACHE_SIZE=512
NYC_REVIEW_AGENT_EMBEDDING_QUERY_CACHE_TTL_SECONDS=900
NYC_REVIEW_AGENT_EMBEDDING_QUERY_PREFIX=
NYC_REVIEW_AGENT_EMBEDDING_DOCUMENT_PREFIX=
NYC_REVIEW_AGENT_EMBEDDING_QUERY_INSTRUCT=

# OpenAI production example:
# NYC_REVIEW_AGENT_EMBEDDING_PROVIDER=openai
# NYC_REVIEW_AGENT_EMBEDDING_BASE_URL=https://api.openai.com/v1
# NYC_REVIEW_AGENT_EMBEDDING_MODEL=text-embedding-3-small
# NYC_REVIEW_AGENT_EMBEDDING_DIMENSIONS=1024

# M1 credentials belong only in the ignored repository-root .env. The Qwen
# adapter converts this compatible URL to its native /api/v1 endpoint so it can
# send text_type=query/document. Voyage is intentionally outside M1.
OPENAI_API_KEY=
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://YOUR_WORKSPACE_ID.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
