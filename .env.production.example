# Copy to .env.production on the server. Never commit the real file.
# Generate each secret with: openssl rand -hex 32

# Use a real DNS name for automatic HTTPS, for example review.example.com.
# Temporary IP-only smoke test: http://YOUR_STATIC_IPV4
APP_SITE_ADDRESS=review.example.com

# Images published by .github/workflows/publish-production-images.yml.
SPRING_IMAGE=ghcr.io/hollis-yang/nyc-review-spring
AGENT_IMAGE=ghcr.io/hollis-yang/nyc-review-agent
WEB_IMAGE=ghcr.io/hollis-yang/nyc-review-web
# Deploy an immutable tag from a successful workflow run: sha-<40-character-commit-sha>
IMAGE_TAG=sha-REPLACE_WITH_FULL_COMMIT_SHA

# Absolute server path containing mysql_import.sql, redis_seed.resp and JSON RAG files.
NYC_REVIEW_DATA_DIR=/opt/nyc-review/data/nyc-real-p13-full

MYSQL_ROOT_PASSWORD=REPLACE_WITH_RANDOM_HEX
NYC_REVIEW_DB_PASSWORD=REPLACE_WITH_DIFFERENT_RANDOM_HEX
NYC_REVIEW_REDIS_PASSWORD=REPLACE_WITH_DIFFERENT_RANDOM_HEX

NYC_REVIEW_RABBITMQ_USERNAME=nyc_review
NYC_REVIEW_RABBITMQ_PASSWORD=REPLACE_WITH_DIFFERENT_RANDOM_HEX
NYC_REVIEW_RABBITMQ_VHOST=/nyc-review

DEEPSEEK_API_KEY=REPLACE_WITH_DEEPSEEK_API_KEY
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# Optional fallback token for recovering an interrupted read-only Agent run.
# Normal browser requests forward the signed-in user's own authorization token.
NYC_REVIEW_AGENT_BACKEND_AUTH_TOKEN=

NYC_REVIEW_AGENT_QDRANT_COLLECTION=nyc_review_content_v2
NYC_REVIEW_AGENT_RETRIEVAL_VERSION=p12-rag-v1
NYC_REVIEW_AGENT_RAG_INDEX_BATCH_SIZE=64
NYC_REVIEW_AGENT_EMBEDDING_PROVIDER=hash
NYC_REVIEW_AGENT_EMBEDDING_DIMENSIONS=64
NYC_REVIEW_AGENT_MODEL_PROVIDER=deepseek
NYC_REVIEW_AGENT_RUNS_PER_MINUTE=10
NYC_REVIEW_AGENT_METRICS_TOKEN=REPLACE_WITH_DIFFERENT_RANDOM_HEX
NYC_REVIEW_AGENT_MCP_API_KEY=REPLACE_WITH_DIFFERENT_RANDOM_HEX
